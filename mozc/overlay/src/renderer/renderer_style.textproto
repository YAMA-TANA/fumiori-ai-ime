# proto-file: protocol/renderer_style.proto
# proto-message: RendererStyle
#
# Fumiori AI IME candidate-window theme.
# The candidate list uses a deliberately limited 8-bit palette. Hard edges,
# stepped corners, and a bright focused card make the AI's choice feel like a
# small game hit without changing Mozc's input behavior.
window_border: 2
footer_height: 32
scrollbar_width: 4
row_rect_padding: 4
border_color { r: 31 g: 23 b: 56 }

shortcut_style {
  font_size: 13
  foreground_color { r: 31 g: 23 b: 56 }
  background_color { r: 255 g: 211 b: 72 }
  left_padding: 10
  right_padding: 10
}

gap1_style { font_size: 15 }

candidate_style {
  font_size: 15
  foreground_color { r: 31 g: 23 b: 56 }
  background_color { r: 255 g: 244 b: 186 }
}

description_style {
  font_size: 11
  foreground_color { r: 139 g: 55 b: 108 }
  right_padding: 12
}

# Keep enough width for Mozc's built-in special candidate labels.
column_minimum_width_string: "そのほかの文字種"

footer_style {
  font_size: 12
  foreground_color { r: 255 g: 255 b: 255 }
  left_padding: 10
  right_padding: 10
}

footer_sub_label_style {
  font_size: 10
  foreground_color { r: 226 g: 207 b: 248 }
  left_padding: 10
  right_padding: 10
}

# Purple footer strip gives the candidate list a clear game-board base.
footer_border_colors { r: 255 g: 111 b: 160 }
footer_top_color { r: 31 g: 23 b: 56 }
footer_bottom_color { r: 73 g: 38 b: 103 }
logo_file_name: "candidate_window_logo.tiff"

# Focused candidate is the "hit" card.  Text remains dark for readability.
# Mint is bright enough for dark candidate text and reads as a successful hit.
focused_background_color { r: 76 g: 222 b: 169 }
focused_border_color { r: 255 g: 72 b: 132 }

scrollbar_background_color { r: 255 g: 230 b: 145 }
scrollbar_indicator_color { r: 87 g: 61 b: 190 }

infolist_style {
  caption_string: "用例"
  caption_height: 26
  caption_padding: 4
  caption_style {
    font_size: 12
    foreground_color { r: 31 g: 23 b: 56 }
    background_color { r: 255 g: 211 b: 72 }
    left_padding: 10
    right_padding: 10
  }
  caption_background_color { r: 255 g: 211 b: 72 }
  window_border: 2
  row_rect_padding: 4
  window_width: 340
  title_style {
    font_size: 15
    foreground_color { r: 31 g: 23 b: 56 }
    left_padding: 12
  }
  description_style {
    font_size: 12
    foreground_color { r: 139 g: 55 b: 108 }
    left_padding: 18
    right_padding: 12
  }
  border_color { r: 31 g: 23 b: 56 }
  focused_background_color { r: 76 g: 222 b: 169 }
  focused_border_color { r: 255 g: 72 b: 132 }
}
